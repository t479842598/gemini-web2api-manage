# Gemini Web2API 环境变量配置
# 复制此文件为 .env 并填入你的配置
# .env 文件已加入 .gitignore，不会提交到 Git

# Google Gemini Cookie（必填）
# 从浏览器登录 gemini.google.com 后，从开发者工具中复制完整的 Cookie 字符串
GEMINI_COOKIE=""

# API Keys（可选，多个用逗号分隔）
# 设置后客户端需要传入 Bearer token 才能访问 API
API_KEYS=""

# 代理配置（可选）
# 格式：http://127.0.0.1:7890 或 socks5://127.0.0.1:7890
PROXY=""

# 模型默认值（可选）
DEFAULT_MODEL="gemini-3.5-flash"

# 管理员密码（可选，默认 sk-admin）
ADMIN_PASSWORD="sk-admin"
