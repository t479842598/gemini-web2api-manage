# Gemini Web2API Manage deployment environment
# Copy to .env only for local tooling; .env is ignored by Git.

# Full Gemini web Cookie. Settings in the admin console are preferred.
GEMINI_COOKIE=""

# Optional API-key allowlist. Comma-separated or JSON array.
API_KEYS=""

# HTTP/HTTPS or SOCKS5 proxy.
# Examples: http://127.0.0.1:7890 or socks5://user:pass@host:port
PROXY=""

# Model and admin settings.
DEFAULT_MODEL="gemini-3.6-flash"
ADMIN_PASSWORD="sk-admin"
PUBLIC_BASE_URL=""
GEMINI_BASE_URL=""
GEMINI_BL=""
XSRF_TOKEN=""

# Runtime and persistence settings.
GEMINI_WEB2API_DATA_DIR=""
GEMINI_WEB2API_CONFIG=""
GEMINI_WEB2API_LOG_FILE=""
PORT="8081"
HOST="0.0.0.0"
REQUEST_TIMEOUT_SEC="180"
RETRY_ATTEMPTS="3"
RETRY_DELAY_SEC="2"
LOG_REQUESTS="true"
TEMPORARY_CHATS="false"
FORCE_NON_STREAM="false"
